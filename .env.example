NODE_ENV=development
PORT=4100

# Where the frontend runs. Several origins can be listed with commas.
CORS_ORIGINS=http://localhost:3100

LOG_LEVEL=debug

# How often prices are pulled from both markets, in minutes.
PRICES_REFRESH_MINUTES=5

# How often item names, pictures and rarities are refreshed, in hours.
CATALOG_REFRESH_HOURS=24

# Sales history ("top offers") and float scans ("float finds") check items one
# by one in the background. A full pass takes about an hour each.
SALES_REFRESH_HOURS=3
FLOAT_REFRESH_HOURS=2

# DMarket allows 12 requests a second in total. Everything, the UI and all
# background scans, shares this budget; the UI always goes first.
DMARKET_REQUESTS_PER_SECOND=10

# Folder for the local cache, so a restart shows prices right away.
CACHE_DIR=.cache

# Optional. Price comparison works without any keys.
# These unlock search for skins with specific stickers and the live listings
# (float, stickers) in the item card.

# white.market: Profile > Partner token (https://white.market/profile)
WHITE_MARKET_PARTNER_TOKEN=

# DMarket: Account settings > Trading API > Generate keys
# (https://dmarket.com/account/api-settings). Both are hex strings.
DMARKET_PUBLIC_KEY=
DMARKET_SECRET_KEY=
